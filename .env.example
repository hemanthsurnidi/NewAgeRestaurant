# Dum & Co. / Company A, Hyderabad - Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# NEVER commit actual secrets or production passwords to version control!

# HTTP Server Port
PORT=3000

# Runtime Environment (development | test | production)
NODE_ENV=development

# Persistent Relational SQLite Database File Path
DATABASE_PATH=./data/nizami.db

# Cryptographic Session & Token Salt Secret (Min 32 characters in production)
SESSION_SECRET=dum_co_secure_scrypt_salt_token_2026_hyderabad_key

# Optional Google Gemini / AI Provider API Key for dynamic natural language chef notes
# If omitted, the deterministic AI workload-aware heuristic engine operates with 100% offline accuracy.
GEMINI_API_KEY=
